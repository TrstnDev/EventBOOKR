@model EventBOOKR.Models.Venue

@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-6 flex justify-between items-center">
    <a asp-action="Index" class="text-slate-400 hover:text-slate-200 transition-colors flex items-center text-sm font-medium">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to Venues
    </a>
    <div class="space-x-3">
        <a asp-action="Edit" asp-route-id="@Model?.VenueId" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-sm font-medium transition-all">Edit Venue</a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-1 space-y-6">
        <div class="bg-slate-800/40 backdrop-blur-sm rounded-xl border border-slate-700/50 overflow-hidden shadow-lg shadow-slate-900/20">
            <div class="h-48 w-full bg-slate-700 relative overflow-hidden">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" />
                }
                else
                {
                    <div class="w-full h-full bg-gradient-to-br from-slate-800 via-slate-800 to-slate-900 border-b border-slate-700 flex items-center justify-center">
                        <svg class="w-16 h-16 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                }
            </div>
            
            <div class="p-6">
                <h1 class="text-2xl font-extrabold text-slate-100 mb-2">@Model.Name</h1>
                <p class="text-slate-400 text-sm flex items-start mb-4">
                    <svg class="w-5 h-5 mr-1.5 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                    @Model.Location
                </p>
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-semibold">
                    Max Capacity: @Model.Capacity pax
                </div>
            </div>
        </div>
    </div>

    <div class="lg:col-span-2">
        <h2 class="text-xl font-bold text-slate-100 mb-4">Upcoming Events Here</h2>
        
        <div class="space-y-4">
            @if (Model.Schedules != null && Model.Schedules.Any())
            {
                foreach (var schedule in Model.Schedules.OrderBy(s => s.StartTime))
                {
                    <div class="bg-slate-800/40 rounded-xl border border-slate-700/50 p-5 flex flex-col sm:flex-row justify-between sm:items-center gap-4 hover:border-blue-500/50 transition-colors">
                        <div>
                            <h3 class="font-bold text-lg text-slate-100">@schedule.Event?.Name</h3>
                            <p class="text-sm text-slate-400 mt-1">
                                @if (schedule.Event?.IsFlexibleSchedule == true)
                                {
                                    <span>From @schedule.StartTime.ToString("MMM dd") to @schedule.EndTime.ToString("MMM dd")</span>
                                }
                                else
                                {
                                    <span>@schedule.StartTime.ToString("f")</span>
                                }
                            </p>
                        </div>
                        <a asp-controller="Bookings" asp-action="Create" class="text-sm font-medium text-blue-400 hover:text-blue-300">Book Tickets &rarr;</a>
                    </div>
                }
            }
            else
            {
                <div class="p-8 text-center bg-slate-800/20 border border-slate-700 border-dashed rounded-xl">
                    <p class="text-slate-500">No events are currently scheduled at this venue.</p>
                </div>
            }
        </div>
    </div>
</div>