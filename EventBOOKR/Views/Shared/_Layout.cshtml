<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventBOOKR</title>
    <link rel="stylesheet" href="~/css/tailwind-output.css" asp-append-version="true" />
</head>
<body class="bg-brand-bg text-black font-sans antialiased min-h-screen relative selection:bg-brand-primary selection:text-white">

    <div class="fixed inset-0 z-[-1] flex flex-col pointer-events-none">
        
        <div class="h-[50vh] w-full bg-brand-secondary relative overflow-hidden">
            <div id="blob-top" class="absolute top-1/2 w-[150vw] h-[150vh] bg-brand-primary blur-[120px] rounded-full will-change-transform" style="left: -120vw; transform: translateY(-50%);"></div>
        </div>
        
        <div class="h-[50vh] w-full bg-brand-primary relative overflow-hidden">
            <div id="blob-bottom" class="absolute top-1/2 w-[150vw] h-[150vh] bg-brand-secondary blur-[120px] rounded-full will-change-transform" style="left: 20vw; transform: translateY(-50%);"></div>
        </div>
        
    </div>

    <header class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4 pointer-events-none">
        <nav class="pointer-events-auto bg-[#F2F0EA]/40 backdrop-blur-2xl rounded-full p-2 flex items-center space-x-1 font-sans text-sm font-medium shadow-sm">
            
            <a class="font-serif font-black text-xl tracking-tight mr-4 px-4" asp-controller="Home" asp-action="Index">eventbookr&deg;</a>
            
            <a asp-controller="Venues" asp-action="Index" class="px-5 py-2.5 rounded-full hover:bg-white text-black transition-colors duration-300">Product</a>
            <a asp-controller="Events" asp-action="Index" class="px-5 py-2.5 rounded-full hover:bg-white text-black transition-colors duration-300">Why uneevo</a>
            <a asp-controller="Bookings" asp-action="Index" class="px-5 py-2.5 rounded-full hover:bg-white text-black transition-colors duration-300">Pricing</a>
            
            <a href="#" class="group inline-flex items-center bg-brand-primary text-black font-sans font-medium rounded-full py-2 pl-2 pr-6 ml-4 transition-all duration-300 hover:scale-[1.02] shadow-sm">
                <div class="relative flex items-center justify-center bg-black rounded-full w-8 h-8 group-hover:w-10 group-hover:h-10 transition-all duration-400 ease-[cubic-bezier(0.34,1.56,0.64,1)] mr-3 group-hover:mr-2">
                    <svg class="w-4 h-4 text-white absolute opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-400 delay-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"></path></svg>
                    <div class="w-2 h-2 bg-white rounded-full group-hover:opacity-0 transition-opacity duration-200"></div>
                </div>
                <span>Book demo</span>
            </a>
            
        </nav>
    </header>

    <main class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        @RenderBody()
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const blobTop = document.getElementById('blob-top');
            const blobBottom = document.getElementById('blob-bottom');
            
            // Default to center
            let targetX = 0.5;
            let currentX = 0.5;

            // Track mouse horizontally
            document.addEventListener('mousemove', (e) => {
                targetX = e.clientX / window.innerWidth;
            });

            // Smooth animation loop
            function animate() {
                // Easing formula for buttery smooth delay
                currentX += (targetX - currentX) * 0.05;
                
                if (blobTop && blobBottom) {
                    // When mouse moves right (currentX -> 1):
                    // Orange blob moves right (filling screen)
                    blobTop.style.transform = `translate(${currentX * 100}vw, -50%)`;
                    
                    // Purple blob moves left (leaving Orange background to fill screen)
                    blobBottom.style.transform = `translate(${currentX * -100}vw, -50%)`;
                }
                
                requestAnimationFrame(animate);
            }
            
            animate();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>