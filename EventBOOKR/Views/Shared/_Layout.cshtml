<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventEase</title>
    <link rel="stylesheet" href="~/css/tailwind-output.css" asp-append-version="true" />
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col">
    
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-900/80 border-b border-slate-800 shadow-sm">
        <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
            
            <a class="text-2xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-emerald-400 hover:opacity-80 transition-opacity" asp-area="" asp-controller="Home" asp-action="Index">
                EventEase
            </a>
            
            <div class="flex space-x-8">
                <a class="text-sm font-medium text-slate-400 hover:text-white transition-colors" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="text-sm font-medium text-slate-400 hover:text-white transition-colors" asp-controller="Venues" asp-action="Index">Venues</a>
                <a class="text-sm font-medium text-slate-400 hover:text-white transition-colors" asp-controller="Events" asp-action="Index">Events</a>
                <a class="text-sm font-medium text-slate-400 hover:text-white transition-colors" asp-controller="Bookings" asp-action="Index">Bookings</a>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow container mx-auto px-6 py-10">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-8 px-4 py-3 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center shadow-sm">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <strong class="font-semibold mr-2">Success!</strong> @TempData["SuccessMessage"]
            </div>
        }

        @RenderBody()
    </main>

    <footer class="border-t border-slate-800 bg-slate-950 mt-auto">
        <div class="container mx-auto px-6 py-6 text-center text-sm text-slate-500">
            &copy; 2026 - EventEase - Built with ASP.NET Core & Tailwind CSS
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>