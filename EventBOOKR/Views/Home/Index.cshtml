@{
    ViewData["Title"] = "Dashboard";
}

<div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
        <span class="text-slate-100">Manage with</span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">EventBOOKR.</span>
    </h1>
    <p class="text-lg md:text-xl text-slate-400 max-w-2xl mb-10">
        Your command center for venues, events, and bookings. 
        Built for simple and speedy event management.
    </p>
    <div class="flex space-x-4">
        <a asp-controller="Venues" asp-action="Create" class="px-8 py-3 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-semibold transition-all shadow-lg shadow-blue-500/30">
            Add New Venue
        </a>
        <a asp-controller="Events" asp-action="Index" class="px-8 py-3 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold border border-slate-700 transition-all">
            Explore Events
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto pb-20">
    
    <a asp-controller="Venues" asp-action="Index" class="group relative bg-slate-800/50 backdrop-blur-sm p-8 rounded-2xl border border-slate-700/50 hover:border-blue-500/50 hover:bg-slate-800 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-500/10 overflow-hidden text-center block">
        <div class="text-6xl font-black text-slate-100 mb-2 group-hover:scale-110 transition-transform duration-300">@ViewBag.TotalVenues</div>
        <div class="text-sm uppercase tracking-widest text-slate-400 font-semibold">Total Venues</div>
    </a>

    <a asp-controller="Events" asp-action="Index" class="group relative bg-slate-800/50 backdrop-blur-sm p-8 rounded-2xl border border-slate-700/50 hover:border-emerald-500/50 hover:bg-slate-800 transition-all duration-300 hover:shadow-2xl hover:shadow-emerald-500/10 overflow-hidden text-center block">
        <div class="text-6xl font-black text-slate-100 mb-2 group-hover:scale-110 transition-transform duration-300">@ViewBag.TotalEvents</div>
        <div class="text-sm uppercase tracking-widest text-slate-400 font-semibold">Active Events</div>
    </a>

    <a asp-controller="Bookings" asp-action="Index" class="group relative bg-slate-800/50 backdrop-blur-sm p-8 rounded-2xl border border-slate-700/50 hover:border-purple-500/50 hover:bg-slate-800 transition-all duration-300 hover:shadow-2xl hover:shadow-purple-500/10 overflow-hidden text-center block">
        <div class="text-6xl font-black text-slate-100 mb-2 group-hover:scale-110 transition-transform duration-300">@ViewBag.TotalBookings</div>
        <div class="text-sm uppercase tracking-widest text-slate-400 font-semibold">Total Bookings</div>
    </a>

</div>