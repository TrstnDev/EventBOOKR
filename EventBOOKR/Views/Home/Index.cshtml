@{
    ViewData["Title"] = "Home";
}

<div class="space-y-32 pt-12 md:pt-20">
    
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 relative z-10">
            <h1 class="font-serif text-[5rem] leading-[0.9] md:text-[7rem] lg:text-[8.5rem] text-black tracking-tight">
                Welcome to <br />
                to <span class="italic pr-4">EventBOOKR.</span>
            </h1>
        </div>
        
        <div class="lg:col-span-5 lg:pt-10 flex flex-col items-start space-y-8 relative z-10">
            <div class="space-y-6 text-lg md:text-xl font-medium text-black/80 font-sans leading-relaxed">
                <p>
                    EventBOOKR is a smart and scalable platform that gives complete control over how organizations plan, execute, and manage events.
                </p>
                <p>
                    Bring together venue coordination, ticketing, scheduling, and guest oversight in one place.
                </p>
            </div>
            
            <a asp-controller="Venues" asp-action="Index" class="group inline-flex items-center bg-brand-primary text-black font-sans font-medium text-lg rounded-full py-3 pl-3 pr-8 transition-all duration-300 hover:scale-[1.02] shadow-sm mt-4">
                <div class="relative flex items-center justify-center bg-black rounded-full w-4 h-4 group-hover:w-10 group-hover:h-10 transition-all duration-400 ease-[cubic-bezier(0.34,1.56,0.64,1)] mr-4 group-hover:mr-3">
                    <svg class="w-5 h-5 text-white absolute opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-400 delay-75" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"></path></svg>
                </div>
                <span>Explore Venues</span>
            </a>
        </div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-[#F2F0EA]/50 backdrop-blur-xl border border-white/40 p-10 md:p-16 rounded-[3rem] shadow-sm relative z-10">
        <div class="lg:col-span-5 space-y-6">
            <p class="text-sm font-bold tracking-widest text-black/40 uppercase">Main Benefits</p>
            <h2 class="font-serif text-5xl md:text-7xl leading-[0.9] tracking-tight text-black">
                Maximize <br />
                <span class="italic pr-2">event success</span>
            </h2>
            <p class="text-lg font-medium text-black/70 font-sans pt-4 leading-relaxed">
                Define your events, match the perfect venues, and have complete scheduling visibility. Keep your guest experiences at their absolute highest.
            </p>
        </div>
        
        <div class="lg:col-span-7 relative h-full min-h-[300px] w-full bg-white/40 backdrop-blur-md rounded-[2.5rem] border border-white/60 shadow-sm flex items-center justify-center overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-secondary/20 to-brand-primary/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            
            <div class="relative w-3/4 bg-white/90 backdrop-blur-sm rounded-2xl p-6 shadow-sm border border-black/5 transform transition-transform duration-500 group-hover:scale-[1.03]">
                <div class="flex items-center space-x-3 mb-6">
                    <div class="w-3 h-3 rounded-full bg-black/10"></div>
                    <div class="w-3 h-3 rounded-full bg-black/10"></div>
                    <div class="w-3 h-3 rounded-full bg-black/10"></div>
                </div>
                <div class="h-4 w-1/3 bg-black/10 rounded-full mb-4"></div>
                <div class="h-4 w-1/2 bg-black/5 rounded-full mb-8"></div>
                
                <div class="flex justify-between items-end border-t border-black/5 pt-4 mt-8">
                    <div class="h-8 w-24 bg-brand-primary/20 rounded-full"></div>
                    <div class="w-8 h-8 rounded-full bg-black flex items-center justify-center cursor-pointer transition-transform hover:scale-110">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <section class="py-20 text-center flex flex-col items-center justify-center space-y-4 relative z-10">
        <p class="text-sm font-bold tracking-widest text-black/40 uppercase mb-8">More with EventBOOKR</p>
        <h3 class="font-serif text-4xl md:text-6xl lg:text-8xl tracking-tight text-black hover:scale-[1.02] transition-transform cursor-default"><span class="italic">Unified</span> venue view</h3>
        <h3 class="font-serif text-4xl md:text-6xl lg:text-8xl tracking-tight text-black/80 hover:text-black transition-colors cursor-default">Easy <span class="italic">ticket</span> management</h3>
        <h3 class="font-serif text-4xl md:text-6xl lg:text-8xl tracking-tight text-black/60 hover:text-black transition-colors cursor-default">Focus on <span class="italic">experience</span></h3>
        <h3 class="font-serif text-4xl md:text-6xl lg:text-8xl tracking-tight text-black/40 hover:text-black transition-colors cursor-default">Total schedule visibility</h3>
        <h3 class="font-serif text-4xl md:text-6xl lg:text-8xl tracking-tight text-black/20 hover:text-black transition-colors cursor-default">All in <span class="italic">one Place</span></h3>
    </section>
    
</div>