@model IEnumerable<EventBOOKR.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-100">Bookings</h1>
        <p class="text-slate-400 mt-1 text-sm">Manage your event schedules and venue reservations.</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center px-5 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-medium transition-colors shadow-sm shadow-purple-500/20">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        Schedule Booking
    </a>
</div>

<div class="space-y-4">
    @foreach (var item in Model) {
        <div class="bg-slate-800/40 backdrop-blur-sm rounded-xl border border-slate-700/50 p-5 flex flex-col md:flex-row md:items-center justify-between hover:border-purple-500/50 transition-all duration-300 group shadow-sm hover:shadow-md hover:shadow-purple-500/10 gap-6">
            
            <div class="flex items-start md:items-center gap-5">
                
                <div class="flex flex-col items-center justify-center bg-slate-900/80 border border-slate-700 rounded-lg w-16 h-16 shrink-0 group-hover:border-purple-500/50 transition-colors">
                    <span class="text-xs font-bold text-purple-400 uppercase tracking-wider">@item.StartDate.ToString("MMM")</span>
                    <span class="text-2xl font-black text-slate-100 leading-none mt-0.5">@item.StartDate.ToString("dd")</span>
                </div>
                
                <div>
                    <h2 class="text-xl font-bold text-slate-100 mb-1 group-hover:text-purple-300 transition-colors">@item.Event?.Name</h2>
                    
                    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 text-sm text-slate-400">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            @item.Venue?.Name
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            @item.StartDate.ToString("t") - @item.EndDate.ToString("t")
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 md:pt-0 border-t md:border-t-0 border-slate-700/50 md:pl-4 shrink-0">
                <a asp-action="Details" asp-route-id="@item.BookingId" class="text-sm font-semibold text-purple-400 hover:text-purple-300 transition-colors">Details</a>
                <span class="text-slate-700 hidden sm:inline">|</span>
                <a asp-action="Edit" asp-route-id="@item.BookingId" class="text-sm font-medium text-slate-400 hover:text-slate-200 transition-colors">Edit</a>
                <span class="text-slate-700 hidden sm:inline">|</span>
                <a asp-action="Delete" asp-route-id="@item.BookingId" class="text-sm font-medium text-red-400 hover:text-red-300 transition-colors">Delete</a>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-20 bg-slate-800/30 rounded-2xl border border-slate-700 border-dashed mt-6">
        <h3 class="text-lg font-medium text-slate-300">No bookings found</h3>
        <p class="text-slate-500 mt-1">Get started by scheduling an event at a venue.</p>
    </div>
}