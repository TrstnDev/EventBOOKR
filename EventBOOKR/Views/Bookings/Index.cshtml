@model IEnumerable<EventBOOKR.Models.Booking>

@{
    ViewData["Title"] = "Reservations";
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
    <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-100">Reservations</h1>
        <p class="text-slate-400 mt-1 text-sm">Manage your upcoming event tickets.</p>
    </div>
    <a asp-action="Create" class="inline-flex items-center px-5 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-medium transition-colors shadow-sm shadow-purple-500/20">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
        Book Tickets
    </a>
</div>

<div class="space-y-4">
    @foreach (var item in Model) {
        <div class="bg-slate-800/40 backdrop-blur-sm rounded-xl border border-slate-700/50 p-5 flex flex-col md:flex-row md:items-center justify-between hover:border-purple-500/50 transition-all duration-300 group shadow-sm hover:shadow-md hover:shadow-purple-500/10 gap-6">
            
            <div class="flex items-start md:items-center gap-5">
                
                <div class="flex flex-col items-center justify-center bg-slate-900/80 border border-slate-700 rounded-lg w-16 h-16 shrink-0 group-hover:border-purple-500/50 transition-colors">
                    <span class="text-xs font-bold text-purple-400 uppercase tracking-wider">@item.ReservationTime.ToString("MMM")</span>
                    <span class="text-2xl font-black text-slate-100 leading-none mt-0.5">@item.ReservationTime.ToString("dd")</span>
                </div>
                
                <div>
                    <h2 class="text-xl font-bold text-slate-100 mb-1 group-hover:text-purple-300 transition-colors">@item.Schedule?.Event?.Name</h2>
                    
                    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 text-sm text-slate-400">
                        <div class="flex items-center text-purple-200">
                            <svg class="w-4 h-4 mr-1.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                            <span class="font-semibold">@item.Pax Tickets</span>
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                            @item.Schedule?.Venue?.Name
                        </div>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            @item.ReservationTime.ToString("t")
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-4 md:pt-0 border-t md:border-t-0 border-slate-700/50 md:pl-4 shrink-0">
                <form asp-action="Delete" asp-route-id="@item.BookingId" method="post" onsubmit="return confirm('Are you sure you want to cancel these tickets?');">
                    <button type="submit" class="text-sm font-medium text-red-400 hover:text-red-300 transition-colors">Cancel Tickets</button>
                </form>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-20 bg-slate-800/30 rounded-2xl border border-slate-700 border-dashed mt-6">
        <h3 class="text-lg font-medium text-slate-300">No tickets found</h3>
        <p class="text-slate-500 mt-1">Select an event to reserve your spot.</p>
    </div>
}