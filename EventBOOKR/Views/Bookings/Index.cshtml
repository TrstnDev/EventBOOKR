@model IEnumerable<EventBOOKR.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<h1>Bookings</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Booking</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>Venue</th>
        <th>Event</th>
        <th>Start Date</th>
        <th>End Date</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Venue.Name</td>
            <td>@item.Event.Name</td>
            <td>@item.StartDate.ToString("g")</td>
            <td>@item.EndDate.ToString("g")</td>
        </tr>
    }
    </tbody>
</table>