@model EventBOOKR.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-100">Reserve Tickets</h1>
        <p class="text-slate-400 mt-1 text-sm">Select an event to see available dates and venues.</p>
    </div>

    <div class="bg-slate-800/40 backdrop-blur-sm rounded-xl border border-slate-700/50 p-6 md:p-8 shadow-lg shadow-slate-900/20">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-6 bg-red-400/10 p-3 rounded-lg border border-red-400/20"></div>
            
            <div class="space-y-6">
                
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-1">1. Select Event</label>
                    <div class="relative">
                        <select id="eventSelect" class="w-full bg-slate-900/50 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-100 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all shadow-inner appearance-none" asp-items="ViewBag.EventId">
                            <option value="">-- Choose an Event --</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-400">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </div>
                    </div>
                </div>

                <div>
                    <label asp-for="ScheduleId" class="block text-sm font-medium text-slate-300 mb-1">2. Select Venue & Date</label>
                    <div class="relative">
                        <select asp-for="ScheduleId" id="scheduleSelect" class="w-full bg-slate-900/50 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-100 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all shadow-inner appearance-none">
                            <option value="">-- Awaiting Event Selection --</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-400">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </div>
                    </div>
                    <span asp-validation-for="ScheduleId" class="text-red-400 text-xs mt-1.5 block font-medium"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div id="timeContainer" class="hidden">
                        <label asp-for="ReservationTime" class="block text-sm font-medium text-purple-300 mb-1">3. Select Specific Time</label>
                        <input asp-for="ReservationTime" id="ReservationTime" type="datetime-local" step="1800" class="w-full bg-purple-900/20 border border-purple-700/50 rounded-lg px-4 py-2.5 text-purple-100 focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400 transition-all shadow-inner [color-scheme:dark]" />
                        <span asp-validation-for="ReservationTime" class="text-red-400 text-xs mt-1.5 block font-medium"></span>
                    </div>

                    <div>
                        <label asp-for="Pax" class="block text-sm font-medium text-slate-300 mb-1">Ticket Quantity (Pax)</label>
                        <input asp-for="Pax" type="number" min="1" value="1" class="w-full bg-slate-900/50 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-100 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all shadow-inner" />
                        <span asp-validation-for="Pax" class="text-red-400 text-xs mt-1.5 block font-medium"></span>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-700/50 flex items-center justify-between">
                <a asp-action="Index" class="text-sm font-medium text-slate-400 hover:text-slate-200 transition-colors flex items-center">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Back to List
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-medium transition-colors shadow-sm shadow-purple-500/20">
                    Confirm Reservation
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const eventSelect = document.getElementById('eventSelect');
            const scheduleSelect = document.getElementById('scheduleSelect');
            const timeContainer = document.getElementById('timeContainer');
            const timeInput = document.getElementById('ReservationTime');
            let currentSchedules = [];

            // 1. Listen for Event changes
            eventSelect.addEventListener('change', async function() {
                // Reset dropdowns
                scheduleSelect.innerHTML = '<option value="">-- Select Venue & Date --</option>';
                timeContainer.classList.add('hidden');
                
                if (!this.value) return;

                // Fetch data from our new API endpoint
                const response = await fetch(`/Bookings/GetSchedulesForEvent?eventId=${this.value}`);
                currentSchedules = await response.json();

                // Populate the Schedule dropdown
                currentSchedules.forEach(s => {
                    const option = document.createElement('option');
                    option.value = s.scheduleId;
                    option.textContent = s.formattedDisplay;
                    scheduleSelect.appendChild(option);
                });
            });

            // 2. Listen for Schedule changes
            scheduleSelect.addEventListener('change', function() {
                const selectedId = parseInt(this.value);
                const schedule = currentSchedules.find(s => s.scheduleId === selectedId);

                if (!schedule) return;

                // 3. UI Logic for Flexible vs Fixed events
                if (schedule.isFlexible) {
                    // Show time picker, restrict bounds, default to start time
                    timeContainer.classList.remove('hidden');
                    timeInput.min = schedule.startTime;
                    timeInput.max = schedule.endTime;
                    timeInput.value = schedule.startTime; 
                } else {
                    // Hide time picker, lock the value behind the scenes to the exact schedule time
                    timeContainer.classList.add('hidden');
                    timeInput.value = schedule.startTime;
                }
            });
        });
    </script>
}